{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "enabledManagers": [
    "docker-compose",
    "github-actions"
  ],
  "dependencyDashboard": false,
  "automerge": false,
  "minimumReleaseAge": "7 days",
  "internalChecksFilter": "strict",
  "packageRules": [
    {
      "description": "Merge minor and patch updates without review. This repo has no CI, so status checks are ignored.",
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true,
      "automergeType": "pr",
      "ignoreTests": true
    }
  ]
}
